#!/bin/bash
set -xe

function my_python() {
    if which python >/dev/null
    then
        python "$@"
    else
        python3 "$@"
    fi
}

pip install --upgrade pip
pip install --upgrade build
pip install --upgrade setuptools
version="$(my_python -c 'import setuptools; setuptools.setup()' --version)"
rm -f dist/*.tar.gz
my_python -m build --sdist

pip install dist/trash[_-]cli-$version.tar.gz

trash --version
trash-put --version
trash-list --version
trash-rm --version
trash-restore --version
trash-empty --version

# The smoke test runs the real trash-put and trash-empty: keep it away from
# the developer's trash and files by using a temporary data home and a
# temporary working directory.
smoke_dir="$(mktemp -d)"
trap 'rm -rf "$smoke_dir"' EXIT
export XDG_DATA_HOME="$smoke_dir/data"
cd "$smoke_dir"

touch foo bar
trash-put foo bar
trash-list
trash-rm bar
echo | trash-empty
